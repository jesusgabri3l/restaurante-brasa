---
// Tres trazos cortos tipo cómic que salen de un objeto (hacia la derecha; rota con `rotate`).
interface Props {
  color?: string;
  rotate?: number;
  class?: string;
}

const { color = '#fff', rotate = 0, class: className } = Astro.props;
---

<svg
  class:list={['expression-lines', className]}
  viewBox="0 0 44 60"
  style={`color:${color};transform:rotate(${rotate}deg)`}
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round">
    <path d="M14 20 L25 9"></path>
    <path d="M20 30 H38"></path>
    <path d="M14 40 L25 51"></path>
  </g>
</svg>
